# Copy to /etc/soc-watch/agent.env, mode 600, owner root.
# This requires Node.js 24 LTS. Do not commit actual keys or tokens.
SOC_WATCH_SERVER_AGENT=true
SOC_WATCH_DATA_DIR=/var/lib/soc-watch
SOC_WATCH_PUBLIC_ORIGIN=https://laptop-1.tail029be8.ts.net
SOC_WATCH_AGENT_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SOC_WATCH_DATA_SOURCE=browser_relay
# Browser relay uses the work browser's Kibana session. No Elasticsearch key is needed.
# Keep the Server Agent console and a signed-in Kibana tab open on the work computer.
# For independent direct access only, replace the mode above and set:
# SOC_WATCH_DATA_SOURCE=direct
# SOC_WATCH_ELASTIC_URL=https://YOUR_ELASTICSEARCH_HOST:9200
# SOC_WATCH_ELASTIC_API_KEY=YOUR_ENCODED_READ_ONLY_API_KEY
# Optional integrations; never sent to the browser.
SOC_WATCH_GTI_API_KEY=
SOC_WATCH_THREATFOX_KEY=
SOC_WATCH_MALWAREBAZAAR_KEY=
# Optional named analyst tokens (can review/assign/investigate/scan, not change policies).
# SOC_WATCH_ANALYST_TOKENS='[{"name":"analyst-one","token":"ANOTHER_LONG_RANDOM_TOKEN"}]'
# HTTP Elasticsearch is rejected unless explicitly allowed on a trusted network.
# SOC_WATCH_ALLOW_HTTP_ELASTIC=true
