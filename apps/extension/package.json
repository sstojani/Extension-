{
  "name": "@soc-watch/extension",
  "version": "0.12.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && vite build --configLoader runner && node scripts/copy-manifest.mjs && node scripts/verify-build.mjs && node ../../scripts/package-extension.mjs",
    "dev:watch": "node scripts/watch-build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@soc-watch/ioc": "0.1.0",
    "@soc-watch/protocol": "0.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.277",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
