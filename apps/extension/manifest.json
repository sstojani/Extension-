{
  "manifest_version": 3,
  "name": "SOC Watch Bridge",
  "version": "0.1.2",
  "description": "Secure read-only bridge between SOC Watch and authenticated Kibana.",
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://10.10.254.202/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["https://socwatch.internal/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"]
  },
  "action": {
    "default_title": "SOC Watch Bridge",
    "default_popup": "popup.html"
  }
}
