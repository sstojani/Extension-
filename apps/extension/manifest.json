{
  "manifest_version": 3,
  "name": "SOC Watch Bridge",
  "version": "0.12.4",
  "description": "Secure read-only bridge between SOC Watch and authenticated Kibana.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://10.10.254.202/*",
    "http://10.10.254.202/*",
    "https://socwatch.internal/*",
    "https://laptop-1.tail029be8.ts.net/*",
    "https://laptop-1.tail029be8.ts.net:8443/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://threatfox-api.abuse.ch/*",
    "https://mb-api.abuse.ch/*",
    "https://urlhaus.abuse.ch/*",
    "https://feodotracker.abuse.ch/*",
    "https://openphish.com/*",
    "https://threatview.io/*",
    "https://www.virustotal.com/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*",
    "https://api.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://socwatch.internal/*",
        "https://laptop-1.tail029be8.ts.net/*",
        "https://laptop-1.tail029be8.ts.net:8443/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://socwatch.internal/*",
      "https://laptop-1.tail029be8.ts.net/*",
      "https://laptop-1.tail029be8.ts.net:8443/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "action": {
    "default_title": "SOC Watch Bridge",
    "default_icon": {
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon-128.png"
  }
}
